Vente "0..1" <-- "0..*" AvoirVente : vente d'origine facultative
Client "0..1" <-- "0..*" AvoirVente : obligatoire pour solde client
AvoirVente "1" *-- "0..*" LigneAvoirVente
LigneAvoirVente "0..*" --> "0..1" LigneVente : ligne d'origine
LigneAvoirVente "0..*" --> "0..1" Article
AvoirVente "1" *-- "0..*" OperationAvoirVente
OperationAvoirVente "0..*" --> "0..1" Vente : vente cible, selon le type

' Relations : achats
Fournisseur "1" <-- "0..*" Achat
Achat "1" *-- "1..*" LigneAchat
LigneAchat "0..*" --> "1" Article
Fournisseur "1" <-- "0..*" ReglementFournisseur
ReglementFournisseur "1" *-- "1..*" AffectationReglementFournisseur
AffectationReglementFournisseur "0..*" --> "1" Achat : dette soldée
Achat "0..1" <-- "0..*" AvoirAchat : achat d'origine facultatif
Fournisseur "1" <-- "0..*" AvoirAchat
AvoirAchat "1" *-- "0..*" LigneAvoirAchat
LigneAvoirAchat "0..*" --> "0..1" LigneAchat : ligne d'origine
LigneAvoirAchat "0..*" --> "0..1" Article
AvoirAchat "1" *-- "0..*" OperationAvoirAchat
